{
  "name": "automationexercise-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI test suite for https://www.automationexercise.com/",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",`n    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:stable": "playwright test --repeat-each=3",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
